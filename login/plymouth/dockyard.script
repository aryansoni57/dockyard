# Dockyard boot splash. Rings expand from the logo on black,
# repeating until boot finishes.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
unit = H / 1080;
cx = W / 2;
cy = H / 2;

logo_src = Image("logo.png");
ring_src = Image("ring.png");

logo_px = Math.Int(64 * unit);
if (logo_px < 16) logo_px = 16;
logo_img = logo_src.Scale(logo_px, logo_px);
logo = Sprite(logo_img);
logo.SetPosition(cx - logo_px / 2, cy - logo_px / 2, 10);
logo.SetOpacity(0);

for (i = 0; i < 3; i++) {
    ring[i] = Sprite();
    ring[i].SetOpacity(0);
}

frame = 0;
PERIOD = 2.1;   # seconds between repeats of one ring
ANIM = 1.8;     # seconds one ring takes to expand and fade

fun ease_out(p) {
    q = 1 - p;
    return 1 - q * q * q * q * q;
}

fun refresh() {
    t = frame / 50;
    frame++;

    # logo: fades in over 1.2s
    lp = t / 1.2;
    if (lp > 1) lp = 1;
    logo.SetOpacity(ease_out(lp));

    for (i = 0; i < 3; i++) {
        local = t - (0.3 + i * 0.35);
        if (local < 0) {
            ring[i].SetOpacity(0);
        } else {
            local = local - Math.Int(local / PERIOD) * PERIOD;
            if (local >= ANIM) {
                ring[i].SetOpacity(0);
            } else {
                p = local / ANIM;
                k = 0.4 + 3.0 * ease_out(p);               # 0.4 -> 3.4 of 120px
                px = Math.Int(120 * k * unit);
                if (px < 2) px = 2;
                ring[i].SetImage(ring_src.Scale(px, px));
                ring[i].SetPosition(cx - px / 2, cy - px / 2, 5);
                if (p < 0.3) a = 0.8 * (p / 0.3);
                else a = 0.8 * (1 - (p - 0.3) / 0.7);
                ring[i].SetOpacity(a);
            }
        }
    }
}

Plymouth.SetRefreshFunction(refresh);
