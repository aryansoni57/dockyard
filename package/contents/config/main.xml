<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <!-- Launcher: comma-separated favoriteIds of the pinned apps, in order. -->
        <entry name="launcherFavorites" type="String">
            <default>applications:org.kde.dolphin.desktop,preferred://browser,applications:org.kde.konsole.desktop,applications:systemsettings.desktop,applications:org.kde.discover.desktop,applications:org.kde.kate.desktop</default>
        </entry>
        <entry name="launcherGridView" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showStart" type="Bool">
            <default>true</default>
        </entry>
        <!-- Kill switch: Start opens the launcher as a popup over its tile. Off = Plasma's centred popup. -->
        <entry name="tilePopups" type="Bool">
            <default>false</default>
        </entry>
        <!-- Dock bar fill when the dock is a desktop widget: false = frosted glass (55%), true = solid (96%). Panels use the Plasma theme. -->
        <entry name="barOpaque" type="Bool">
            <default>false</default>
        </entry>
        <!-- Accent for the dock's buttons and highlights, as #rrggbb. Empty follows the Plasma theme. -->
        <entry name="accentColor" type="String">
            <default></default>
        </entry>
        <!-- Also set the Plasma accent color (system-wide) when the dock accent changes. -->
        <entry name="syncSystemAccent" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showClock" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showStats" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showMedia" type="Bool">
            <default>true</default>
        </entry>
        <!-- Sensor refresh in ms. Lower = more CPU wakeups. -->
        <entry name="statsInterval" type="Int">
            <default>2000</default>
        </entry>

        <entry name="showTemperature" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showNetwork" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showStorage" type="Bool">
            <default>false</default>
        </entry>
        <!-- Script tile: shows the output of scriptCommand, run every scriptInterval seconds. -->
        <entry name="showScript" type="Bool">
            <default>false</default>
        </entry>
        <entry name="scriptCommand" type="String">
            <default></default>
        </entry>
        <entry name="scriptLabel" type="String">
            <default></default>
        </entry>
        <entry name="scriptIcon" type="String">
            <default>utilities-terminal</default>
        </entry>
        <entry name="scriptInterval" type="Int">
            <default>60</default>
        </entry>
        <entry name="scriptClickCommand" type="String">
            <default></default>
        </entry>
        <entry name="showBattery" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showWeather" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showPomodoro" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showTimer" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showStopwatch" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showWorldClocks" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showTodos" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showApps" type="Bool">
            <default>false</default>
        </entry>
        <!-- Icons near the pointer grow, like a macOS dock. -->
        <entry name="appMagnify" type="Bool">
            <default>false</default>
        </entry>
        <!-- Hovering a window thumbnail in the app card fades every other window out. -->
        <entry name="peekWindows" type="Bool">
            <default>false</default>
        </entry>
        <!-- Follow the pinned apps of the Task Manager panel applet. appLaunchers is the fallback. -->
        <entry name="appsFromTaskManager" type="Bool">
            <default>true</default>
        </entry>
        <!-- Comma-separated launcher IDs, e.g. preferred://browser,applications:org.kde.dolphin.desktop -->
        <entry name="appLaunchers" type="String">
            <default>preferred://browser,applications:org.kde.dolphin.desktop,applications:org.kde.konsole.desktop,applications:systemsettings.desktop,applications:discord.desktop</default>
        </entry>
        <!-- Written by the Dockyard KWin script on Meta+1..9: "<index>:<time>". The time makes each press a change. -->
        <entry name="taskShortcut" type="String">
            <default></default>
        </entry>
        <entry name="showToggles" type="Bool">
            <default>false</default>
        </entry>
        <!-- Comma-separated keys: wifi, bluetooth, dnd, nightlight, mute, quickshare. -->
        <entry name="toggleItems" type="String">
            <default>wifi,bluetooth,dnd,nightlight,mute</default>
        </entry>

        <!-- Battery sensors are power/DEVICE/chargePercentage and chargeRate.
             Find DEVICE with: kstatsviewer, then list sensors and look for power. -->
        <entry name="batteryDevice" type="String">
            <default>SerialNumber</default>
        </entry>
        <entry name="latitude" type="String">
            <default>0</default>
        </entry>
        <entry name="longitude" type="String">
            <default>0</default>
        </entry>
        <!-- Label for the coordinates above, e.g. "Mumbai, India". Display only. -->
        <entry name="locationName" type="String">
            <default></default>
        </entry>
        <entry name="fahrenheit" type="Bool">
            <default>false</default>
        </entry>
        <entry name="worldZones" type="String">
            <default>America/New_York,Europe/London,Asia/Tokyo</default>
        </entry>
        <entry name="showCalendar" type="Bool">
            <default>true</default>
        </entry>
        <entry name="calendarSource" type="String">
            <default></default>
        </entry>
        <entry name="planeUrl" type="String">
            <default>https://api.plane.so</default>
        </entry>
        <entry name="planeWorkspace" type="String">
            <default></default>
        </entry>
        <entry name="planeApiKey" type="String">
            <default></default>
        </entry>
        <entry name="showMonthProgress" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showDayProgress" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showYearProgress" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showDate" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showClockStyle" type="Bool">
            <default>false</default>
        </entry>
        <!-- Look of the clock-styles tile: digital, flip, worldanalog, classic, classicdark,
             minimal, week, worldlist, worldtime, today, segment. -->
        <entry name="clockStyle" type="String">
            <default>digital</default>
        </entry>
        <entry name="showDayNumber" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showNotes" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showVolume" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showRecycleBin" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showScreenshot" type="Bool">
            <default>false</default>
        </entry>
        <!-- "strip" (status glyphs, tap opens the flyout) or "toggles" (pill row). -->
        <entry name="toggleStyle" type="String">
            <default>strip</default>
        </entry>
        <entry name="showTray" type="Bool">
            <default>false</default>
        </entry>
        <!-- Old single note. Read once as the first note when notesJson is empty. -->
        <entry name="notesText" type="String">
            <default></default>
        </entry>
        <!-- Notes: [{"text": "..."}]. notesCurrent is the one the tile shows. -->
        <entry name="notesJson" type="String">
            <default>[]</default>
        </entry>
        <entry name="notesCurrent" type="Int">
            <default>0</default>
        </entry>
        <!-- Tile order, comma-separated tile keys. Written by dragging tiles. -->
        <entry name="tileOrder" type="String">
            <default></default>
        </entry>
        <entry name="todosJson" type="String">
            <default>[]</default>
        </entry>
    </group>
</kcfg>
