[%General]
author=aryan
comment=Dockyard Day: light glass. Popups, menus and tooltips are glass; windows are solid.
x11drag=all
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=3
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
menu_separator_height=6
splitter_width=4
scroll_width=8
scroll_arrows=false
scroll_min_extent=48
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=false
reduce_window_opacity=0
reduce_menu_opacity=0
blurring=true
popup_blurring=true
menu_blur_radius=10
tooltip_blur_radius=10
vertical_spin_indicators=true
inline_spin_indicators=true
spin_button_width=28
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
combo_menu=true
hide_combo_checkboxes=true
groupbox_top_label=true
animate_states=true
button_contents_shift=false
layout_spacing=6
layout_margin=9
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=true
tooltip_delay=-1
tree_branch_line=false
dark_titlebar=false
no_inactiveness=true
respect_DE=true
opaque=QMPlay2,kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,avidemux,kamoso,QtCreator,VirtualBox,dragon,digikam,virtualboxvm

[GeneralColors]
window.color=#eff0f4
base.color=#ffffff
alt.base.color=#f4f5f8
button.color={'normal': ((255, 255, 255), 1, (0, 0, 0), 0.13), 'focused': ((255, 255, 255), 1, (0, 0, 0), 0.22), 'pressed': ((230, 232, 238), 1, (0, 0, 0), 0.18), 'toggled': ((10, 122, 255), 0.16, (10, 122, 255), 0.6), 'disabled': ((255, 255, 255), 0.55, (0, 0, 0), 0.07)}
light.color=#f6f7fa
mid.color=#d5d7df
dark.color=#a9acb8
highlight.color=#0064d6
text.color=#1c1c1e
window.text.color=#1c1c1e
button.text.color=#1c1c1e
disabled.text.color=#9a9ca5
tooltip.base.color=#f8f8fb
tooltip.text.color=#1c1c1e
link.color=#0058c4
link.visited.color=#8a3fb5
highlight.text.color=#ffffff
progress.indicator.text.color=#ffffff

[Hacks]
transparent_dolphin_view=true
transparent_ktitle_label=true
transparent_menutitle=true
blur_translucent=false
respect_darkness=true
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
tint_on_mouseover=0
no_selection_tint=false
centered_forms=true
kinetic_scrolling=false
middle_click_scroll=false
single_top_toolbar=true
force_size_grip=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.iconspacing=4
min_width=+0.3font
min_height=+0.3font
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.normal.color=#1c1c1e
text.focus.color=#1c1c1e
text.press.color=#1c1c1e
text.toggle.color=#1c1c1e

