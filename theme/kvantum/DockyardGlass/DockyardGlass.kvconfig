[%General]
author=aryan
comment=Dockyard: dark glass. Popups, menus and tooltips are glass; windows are glass too.
x11drag=all
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=3
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
menu_separator_height=6
splitter_width=4
scroll_width=8
scroll_arrows=false
scroll_min_extent=48
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=true
reduce_window_opacity=12
reduce_menu_opacity=0
blurring=true
popup_blurring=true
menu_blur_radius=10
tooltip_blur_radius=10
vertical_spin_indicators=true
inline_spin_indicators=true
spin_button_width=28
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_as_lineedit=true
combo_menu=true
hide_combo_checkboxes=true
groupbox_top_label=true
animate_states=true
button_contents_shift=false
layout_spacing=6
layout_margin=9
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=true
tooltip_delay=-1
tree_branch_line=false
dark_titlebar=true
no_inactiveness=true
respect_DE=true
opaque=QMPlay2,kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,avidemux,kamoso,QtCreator,VirtualBox,dragon,digikam,virtualboxvm

[GeneralColors]
window.color=#1b1b21
base.color=#131317
alt.base.color=#18181d
button.color={'normal': ((255, 255, 255), 0.12, (255, 255, 255), 0.14), 'focused': ((255, 255, 255), 0.17, (255, 255, 255), 0.14), 'pressed': ((255, 255, 255), 0.22, (255, 255, 255), 0.14), 'toggled': ((10, 132, 255), 0.35, (10, 132, 255), 0.5), 'disabled': ((255, 255, 255), 0.06, (255, 255, 255), 0.08)}
light.color=#363640
mid.color=#2e2e37
dark.color=#0e0e10
highlight.color=#0071e3
text.color=#ecedf2
window.text.color=#ecedf2
button.text.color=#ecedf2
disabled.text.color=#8e8e93
tooltip.base.color=#16161a
tooltip.text.color=#ecedf2
link.color=#64d2ff
link.visited.color=#bf5af2
highlight.text.color=#ffffff
progress.indicator.text.color=#ffffff

[Hacks]
transparent_dolphin_view=true
transparent_ktitle_label=true
transparent_menutitle=true
blur_translucent=true
respect_darkness=true
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
tint_on_mouseover=0
no_selection_tint=false
centered_forms=true
kinetic_scrolling=false
middle_click_scroll=false
single_top_toolbar=true
force_size_grip=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.iconspacing=4
min_width=+0.3font
min_height=+0.3font
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.normal.color=#ecedf2
text.focus.color=#ecedf2
text.press.color=#ecedf2
text.toggle.color=#ecedf2

